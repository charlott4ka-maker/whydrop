{
  "expo": {
    "name": "Ago",
    "slug": "ago",
    "scheme": "ago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "primaryColor": "#C8FF4A",
    "ios": {
      "bundleIdentifier": "app.ago.ios",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["ru"]
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.ago.ios"]
      },
      "appleTeamId": "ЗАМЕНИ_НА_TEAM_ID"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
