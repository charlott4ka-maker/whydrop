# Meta app (developers.facebook.com) -> Instagram -> API setup with Unified login
IG_CLIENT_ID=
IG_CLIENT_SECRET=
# "ID конфигурации" shown on the configuration card
IG_CONFIG_ID=

# Only if the callback does not sit on the deployment's own host
# IG_REDIRECT_URI=https://whydrop-phi.vercel.app/api/instagram/callback

# The app's URL scheme, must match "scheme" in mobile/app.json
APP_SCHEME=whydrop

# Temporary, for /api/instagram/probe while the client code is being written.
# Unset it to switch the probe off.
IG_TEST_TOKEN=
