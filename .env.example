# Meta app (developers.facebook.com, product "Instagram" / API with Instagram Login)
IG_CLIENT_ID=
IG_CLIENT_SECRET=

# Only if the callback does not sit on the deployment's own host
# IG_REDIRECT_URI=https://whydrop.vercel.app/api/instagram/callback

# The app's URL scheme, must match "scheme" in mobile/app.json
APP_SCHEME=whydrop
